#include <windows.h>
#pragma code_page(65001)

#define IDD_SETTINGS    200
#define IDC_S_COMPRESS  201
#define IDC_S_QUALITY   202
#define IDC_S_CHANNELS  203
#define IDC_S_KEEPWAV   204
#define IDC_S_MAXMB     205
#define IDC_S_SPLIT     206
#define IDC_S_NOTE      207
#define IDC_S_INFO      208
#define IDC_S_MODE      209
#define IDC_S_SEG       210
#define IDC_S_SILCUT    211
#define IDC_S_SILMIN    212
#define IDC_S_SILPAD    213
#define IDC_S_SILDB     214

1 ICON "loopback_rec.ico"
1 RT_MANIFEST "loopback_rec_gui.manifest"

1 VERSIONINFO
FILEVERSION     1,3,11,0
PRODUCTVERSION  1,3,11,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Federico Fusco"
      VALUE "FileDescription",  "Loopback Rec - system audio recorder"
      VALUE "FileVersion",      "1.3.11.0"
      VALUE "InternalName",     "loopback_rec_gui"
      VALUE "OriginalFilename", "loopback_rec_gui.exe"
      VALUE "ProductName",      "Loopback Rec"
      VALUE "ProductVersion",   "1.3.11"
      VALUE "LegalCopyright",   "(c) 2026 Federico Fusco"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 280, 310
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Impostazioni"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  GROUPBOX        "Compressione", -1, 7, 4, 266, 124
  AUTOCHECKBOX    "&Comprimi in AAC (.m4a)", IDC_S_COMPRESS, 14, 16, 252, 12, WS_TABSTOP
  LTEXT           "Com&primi:", -1, 14, 35, 46, 10
  COMBOBOX        IDC_S_MODE, 62, 33, 204, 60, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT           "&Qualità:", -1, 14, 53, 46, 10
  COMBOBOX        IDC_S_QUALITY, 62, 51, 204, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "C&anali:", -1, 14, 71, 46, 10
  COMBOBOX        IDC_S_CHANNELS, 62, 69, 80, 60, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT           "&Salvataggio sicuro ogni:", -1, 14, 89, 90, 10
  COMBOBOX        IDC_S_SEG, 106, 87, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "(se il PC si blocca)", -1, 170, 89, 96, 10
  AUTOCHECKBOX    "&Tieni anche il file WAV (solo ""dopo"")", IDC_S_KEEPWAV, 14, 108, 220, 12, WS_TABSTOP
  GROUPBOX        "File", -1, 7, 132, 266, 74
  LTEXT           "Dimensione &massima per file (MB):", -1, 14, 146, 124, 10
  EDITTEXT        IDC_S_MAXMB, 140, 144, 40, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT           "Dividi &file ogni:", -1, 14, 164, 124, 10
  COMBOBOX        IDC_S_SPLIT, 140, 162, 126, 80, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT           "", IDC_S_INFO, 14, 180, 252, 22
  GROUPBOX        "Taglia silenzi", -1, 7, 210, 266, 74
  AUTOCHECKBOX    "Taglia automaticamente i si&lenzi", IDC_S_SILCUT, 14, 222, 252, 12, WS_TABSTOP
  LTEXT           "Silenzio minimo (s):", -1, 14, 240, 92, 10
  EDITTEXT        IDC_S_SILMIN, 108, 238, 32, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT           "taglia solo pause più lunghe", -1, 146, 240, 122, 10
  LTEXT           "Margine prima/dopo (ms):", -1, 14, 254, 92, 10
  EDITTEXT        IDC_S_SILPAD, 108, 252, 32, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT           "per non tagliare le parole", -1, 146, 254, 122, 10
  LTEXT           "Soglia silenzio (dB):", -1, 14, 268, 92, 10
  EDITTEXT        IDC_S_SILDB, 108, 266, 32, 13, ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT           "più basso = taglia solo silenzio vero", -1, 146, 268, 122, 10
  LTEXT           "", IDC_S_NOTE, 7, 288, 160, 18
  DEFPUSHBUTTON   "OK", IDOK, 170, 289, 50, 14
  PUSHBUTTON      "Annulla", IDCANCEL, 223, 289, 50, 14
END
